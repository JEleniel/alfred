{
	"$defs": {
		"acronym": {
			"pattern": "^[A-Z]{3}$",
			"type": "string"
		},
		"card_common_property": {
			"additionalProperties": false,
			"properties": {
				"description": {
					"$ref": "#/$defs/non_empty"
				},
				"name": {
					"$ref": "#/$defs/non_empty"
				}
			},
			"required": ["name", "description"],
			"type": "object"
		},
		"card_entry": {
			"additionalProperties": false,
			"properties": {
				"acronym": {
					"$ref": "#/$defs/acronym"
				},
				"card_type": {
					"$ref": "#/$defs/non_empty"
				},
				"common_properties": {
					"items": {
						"$ref": "#/$defs/card_common_property"
					},
					"minItems": 1,
					"type": "array",
					"uniqueItems": true
				},
				"common_subtypes": {
					"items": {
						"$ref": "#/$defs/non_empty"
					},
					"minItems": 1,
					"type": "array",
					"uniqueItems": true
				},
				"description": {
					"$ref": "#/$defs/non_empty"
				},
				"relationships": {
					"items": {
						"$ref": "#/$defs/card_relationship"
					},
					"minItems": 1,
					"type": "array",
					"uniqueItems": true
				}
			},
			"required": ["card_type", "acronym", "description"],
			"type": "object"
		},
		"card_relationship": {
			"additionalProperties": false,
			"properties": {
				"relationship": {
					"$ref": "#/$defs/non_empty"
				},
				"target": {
					"$ref": "#/$defs/acronym"
				}
			},
			"required": ["target", "relationship"],
			"type": "object"
		},
		"cards": {
			"items": {
				"$ref": "#/$defs/card_entry"
			},
			"minItems": 1,
			"type": "array",
			"uniqueItems": true
		},
		"hex_color": {
			"pattern": "^#[A-Fa-f0-9]{6}$",
			"type": "string"
		},
		"icon_name": {
			"minLength": 1,
			"pattern": "^[a-z][a-z0-9-_]*$",
			"type": "string"
		},
		"non_empty": {
			"minLength": 1,
			"type": "string"
		}
	},
	"$id": "https://crystultima.org/aurora/modelconfiguration.schema.json",
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"additionalProperties": false,
	"description": "Schema for Aurora.modelconfiguration.json with card-centric canonical definitions and per-card relationships.",
	"properties": {
		"$schema": {
			"minLength": 1,
			"type": "string"
		},
		"version": {
			"$ref": "#/$defs/non_empty"
		},
		"cards": {
			"$ref": "#/$defs/cards"
		}
	},
	"required": ["cards"],
	"title": "Aurora Model Configuration Schema",
	"type": "object"
}
