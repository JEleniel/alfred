			"relationship": "limits",
			"target": "REQ-003"
		},
		{
			"relationship": "limits",
			"target": "REQ-007"
		},
		{
			"relationship": "limits",
			"target": "REQ-012"
		}
	],
	"name": "UTF-8 Protocol and Path Encoding Handling"
}
