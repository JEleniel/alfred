{
	"$schema": "../../schemas/Aurora.card.schema.json",
	"attributes": {
		"config_precedence": {
			"workspace_overrides_user": true
		},
		"external_tools": {
			"error_kind_on_missing": "tool_unavailable",
			"probe_methods": ["--version", "--help"],
			"require_probe": true
		},
		"plan_writes": {
			"atomic_write_required": true,
			"lock_files_forbidden": true,
			"concurrent_writers": "unsupported_last_write_wins"
		},
		"tool_exposure": {
			"calling_disabled_tool_is_error": true,
			"disabled_tools_omitted_from_capabilities": true,
			"error_kind": "invalid_argument"
		}
	},
	"card_type": "Constraint",
	"description": "Alfred MUST provide an IDE-compliant permission model and configurable policy guardrails with reasonable defaults. Tool exposure and plan writes MUST be governed by deterministic policies.",
	"external_references": ["docs/design/ToolContracts.md", "docs/design/Configuration.md"],
	"id": "CNS-010",
	"links": [],
	"name": "Permission Model and Guardrails"
}
